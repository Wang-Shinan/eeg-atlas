---
import '../styles/global.css';
import { site, tracks } from '../site.config';
import { withBase } from '../lib/urls';
import SidebarNav from '../components/SidebarNav.astro';
import ContentStudio from '../components/ContentStudio.astro';
import FigureViewer from '../components/FigureViewer.astro';
interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} — 脑电与脑机接口`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = currentPath === withBase('/').replace(/\/+$/, '') || currentPath === '/';
const hasRail = Astro.slots.has('rail');
const editorEnabled = import.meta.env.PUBLIC_CONTENT_EDITOR !== 'false';
const activeTrack = tracks.find(t => currentPath.includes(`/chapters/${t.id}/`))?.id;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title><meta name="description" content={description} />
  <meta name="theme-color" content="#142e35" />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
</head>
<body class:list={[isHome && 'home-page']}>
  <a class="skip-link" href="#main-content">跳到正文</a>
  {editorEnabled && <ContentStudio />}
  <header class="site-header">
    <div class="header-inner">
      <a class="site-brand" href={withBase('/')}><span class="brand-letter" aria-hidden="true">e.</span><span>EEG Atlas<small>脑电与脑机接口</small></span></a>
      <nav class="top-nav" aria-label="专题导航">
        {tracks.map(t => <a href={withBase(`/#${t.id}`)} aria-current={(isHome && t.id === 'eeg') || activeTrack === t.id ? 'page' : undefined}>{t.id === 'eeg' ? '脑电与 BCI' : t.id === 'foundation-models' ? '基础模型' : '数据规范'}</a>)}
      </nav>
      <a class="header-reference" href={withBase('/sources/')}>图源与参考</a>
      {!isHome && <button class="menu-button" type="button" aria-controls="site-sidebar" aria-expanded="false" data-nav-toggle>章节目录</button>}
    </div>
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
  </header>
  <div class:list={['site-frame', isHome && 'site-frame-home', hasRail && 'with-rail']}>
    {!isHome && <>
      <button class="nav-overlay" aria-label="关闭章节目录" data-nav-close tabindex="-1"></button>
      <aside id="site-sidebar" class="site-sidebar">
        <div class="mobile-sidebar-header"><strong>章节目录</strong><button type="button" data-nav-close>关闭</button></div>
        <SidebarNav currentPath={currentPath} />
      </aside>
    </>}
    <main id="main-content" class="main-content" tabindex="-1"><slot /></main>
    {hasRail && <aside class="page-rail"><slot name="rail" /></aside>}
  </div>
  <FigureViewer />
  <footer class="site-footer"><a href={withBase('/')}>EEG Atlas <span>脑电与脑机接口</span></a><p>从信号与实验，到人机协作。</p><a href={withBase('/sources/')}>图片出处与参考资料</a></footer>
  <script>
    const header = document.querySelector<HTMLElement>('.site-header');
    if (header) new ResizeObserver(() => document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`)).observe(header);
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const sidebar = document.querySelector<HTMLElement>('#site-sidebar');
    const closeNav = () => { document.body.classList.remove('nav-open'); toggle?.setAttribute('aria-expanded', 'false'); };
    toggle?.addEventListener('click', () => {
      const open = !document.body.classList.contains('nav-open');
      document.body.classList.toggle('nav-open', open); toggle.setAttribute('aria-expanded', String(open));
      if (open) sidebar?.querySelector<HTMLButtonElement>('button')?.focus();
    });
    document.querySelectorAll('[data-nav-close]').forEach(el => el.addEventListener('click', () => { closeNav(); toggle?.focus(); }));
    sidebar?.querySelectorAll('a').forEach(el => el.addEventListener('click', closeNav));
    document.addEventListener('keydown', event => {
      if (!document.body.classList.contains('nav-open')) return;
      if (event.key === 'Escape') { closeNav(); toggle?.focus(); }
      if (event.key === 'Tab' && sidebar) {
        const focusable = Array.from(sidebar.querySelectorAll<HTMLElement>('a[href], button')).filter(el => el.getClientRects().length);
        const first = focusable[0], last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (event.key === 'Tab' && !event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    });
    document.querySelectorAll('.prose-chapter table').forEach(table => {
      if (table.parentElement?.classList.contains('table-scroll')) return;
      const wrapper = document.createElement('div'); wrapper.className = 'table-scroll'; wrapper.tabIndex = 0; wrapper.setAttribute('role', 'region'); wrapper.setAttribute('aria-label', '资料表，可横向滚动'); table.before(wrapper); wrapper.append(table);
    });
    const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
    function updateProgress() { const distance = document.documentElement.scrollHeight - innerHeight; if (progress) progress.style.transform = `scaleX(${distance > 0 ? scrollY / distance : 0})`; }
    addEventListener('scroll', updateProgress, {passive: true}); updateProgress();
  </script>
</body>
</html>
