---
import { chapterHref, chapterNumber, getTrackSections } from '../lib/chapters';
import { withBase } from '../lib/urls';

interface Props {
  /** Normalized pathname without trailing slash (except root). */
  currentPath: string;
}

const { currentPath } = Astro.props;
const sections = await getTrackSections();

function isActive(href: string): boolean {
  const target = href.replace(/\/+$/, '') || '/';
  return currentPath === target;
}
---

<nav aria-label="章节导航" class="font-sans text-sm">
  <a
    href={withBase('/')}
    class:list={[
      'mb-6 block rounded px-2 py-1.5 text-[0.8125rem] transition-colors',
      isActive(withBase('/'))
        ? 'bg-accent-soft font-medium text-accent'
        : 'text-muted hover:bg-accent-soft/60 hover:text-ink',
    ]}
  >
    全部章节
  </a>

  {
    sections.map((section) => (
      <div class="mb-7">
        <p class="px-2 font-sans text-[0.6875rem] font-semibold tracking-[0.1em] text-accent">
          {section.track.label}
        </p>
        <p class="mt-0.5 px-2 font-serif text-[0.7rem] italic text-muted">{section.track.tagline}</p>

        {section.groups.map((group) => (
          <div class="mt-3">
            <p class="px-2 text-[0.6875rem] font-medium text-muted/90">{group.name}</p>
            <ul class="mt-1 space-y-0.5">
              {group.chapters.map((chapter) => {
                const href = chapterHref(chapter);
                const active = isActive(href);
                return (
                  <li>
                    <a
                      href={href}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'flex items-baseline gap-2 rounded px-2 py-1.5 leading-snug transition-colors',
                        active
                          ? 'bg-accent-soft font-medium text-ink'
                          : 'text-muted hover:bg-accent-soft/50 hover:text-ink',
                      ]}
                    >
                      <span class="w-5 shrink-0 text-[0.6875rem] tabular-nums text-muted/80">
                        {chapterNumber(chapter)}
                      </span>
                      <span class="min-w-0 text-[0.8125rem]">{chapter.data.title}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    ))
  }
</nav>
