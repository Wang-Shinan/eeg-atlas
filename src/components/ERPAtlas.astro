---
import { erpCards } from '../data/erp-components';
import '../styles/bci.css';
---
<section class="bci-lab not-prose" data-erp-atlas aria-label="ERP 成分与范式图谱">
  <header><span class="bci-eyebrow">先选一个你想了解的问题</span><h3>从实验认识大脑的回应</h3><p>每张卡片先解释实验怎样安排，再给出研究名称。曲线是教学示意，用来说明大致的时间关系；原始研究可从卡片链接查阅。</p></header>
  <label>想了解哪种情境 <select data-erp-select>{erpCards.map(c => <option value={c.id}>{c.name}</option>)}</select></label>
  <div class="erp-display" aria-live="polite"><p data-erp-zero>各成分的零时刻不同，请查看卡片。</p><p data-erp-contrast>差异波的符号取决于相减顺序。</p><canvas data-erp-canvas width="840" height="260" role="img" aria-label="当前成分的参数化差异波示意，任意幅度单位，非实测"></canvas><p>横轴从事件前一秒到后一秒，0 是卡片说明的事件时刻；1000 ms 为一秒。曲线高低是人为设定的示意大小。</p></div>
  <div>{erpCards.map(c => <details class="erp-card" data-erp-card={c.id} id={`erp-${c.id}`}><summary>{c.name}</summary><dl><dt>实验怎么安排</dt><dd>{c.task}</dd><dt>从哪一刻看</dt><dd>{c.zero}</dd><dt>比较什么</dt><dd>{c.contrast}</dd></dl><details><summary>继续看：位置、时间与解释范围</summary><dl><dt>常看哪些位置</dt><dd>{c.region}</dd><dt>常看哪段时间</dt><dd>{c.timing}</dd><dt>怎样理解结果</dt><dd>{c.boundary}</dd></dl></details><p><a href={c.url} target="_blank" rel="noreferrer">{c.source} ↗</a></p></details>)}</div>
</section>
<script>
  import { erpCards } from '../data/erp-components';
  import { gaussian } from '../lib/bci/epochs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-erp-atlas]')) {
    const select = root.querySelector<HTMLSelectElement>('[data-erp-select]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-erp-canvas]')!;
    const ctx = canvas.getContext('2d');
    function draw() {
      if (!ctx) return;
      const c = erpCards.find(v => v.id === select.value)!;
      const width = Math.max(240, canvas.getBoundingClientRect().width), height = 260, dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(width * dpr); canvas.height = Math.round(height * dpr); canvas.style.height = height + 'px';
      ctx.setTransform(dpr,0,0,dpr,0,0); ctx.fillStyle='#fff';ctx.fillRect(0,0,width,height);ctx.font='12px sans-serif';
      const x = (t:number) => 32+(t+1000)/2000*(width-50);
      ctx.strokeStyle='#c8d3d0';ctx.beginPath();ctx.moveTo(x(-1000),130);ctx.lineTo(x(1000),130);ctx.moveTo(x(0),25);ctx.lineTo(x(0),220);ctx.stroke();
      ctx.fillStyle='#435b60';const step=width<500?500:250;
      for(let t=-1000;t<=1000;t+=step){ctx.textAlign=t===1000?'right':'center';ctx.fillText(String(t),x(t),244);}
      ctx.textAlign='right';ctx.fillText('ms',width-18,16);
      ctx.strokeStyle='#1a7275';ctx.lineWidth=3;ctx.beginPath();
      for(let t=-1000;t<=1000;t+=4){let v=c.sign*gaussian(t,c.center,c.width);
        if(c.id==='sensory')v=gaussian(t,95,22)-.9*gaussian(t,160,28)+.65*gaussian(t,240,40);
        if(c.id==='cnv')v=t>=-800&&t<=0?-(t+800)/800:t>0?-Math.exp(-t/60):0;
        if(c.id==='lrp')v=t>=-400&&t<=0?-(t+400)/400:t>0?-Math.exp(-t/100):0;
        const py=130-80*v;t===-1000?ctx.moveTo(x(t),py):ctx.lineTo(x(t),py);
      }ctx.stroke();
    }
    function render() {
      const c = erpCards.find(v => v.id === select.value)!;
      root.dataset.selected = c.id;
      root.querySelector('[data-erp-zero]')!.textContent = `0 ms：${c.zero}`;
      root.querySelector('[data-erp-contrast]')!.textContent = `对照：${c.contrast}`;
      root.querySelectorAll<HTMLDetailsElement>('[data-erp-card]').forEach(el => { const selected = el.dataset.erpCard === c.id; el.dataset.selected = String(selected); el.open = selected; });
      draw();
    }
    select.addEventListener('change',render);render();new ResizeObserver(draw).observe(canvas);
  }
</script>
