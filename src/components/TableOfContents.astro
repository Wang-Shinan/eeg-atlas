---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Deeper levels make the rail noisy next to a long reading column.
const visible = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  visible.length > 0 && (
    <nav aria-label="本页目录" class="sticky top-24">
      <p class="font-sans text-[0.6875rem] font-semibold tracking-[0.08em] text-muted">
        本页目录
      </p>
      <ul class="mt-3 space-y-2 border-l border-rule">
        {visible.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                'block border-l-2 border-transparent py-0.5 font-sans text-[0.8125rem] leading-snug text-muted transition-colors hover:border-accent hover:text-ink',
                heading.depth === 2 ? 'pl-3' : 'pl-6 text-[0.75rem]',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
