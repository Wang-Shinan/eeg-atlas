---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { tracks } from '../../site.config';
import { withBase } from '../../lib/urls';
import {
  chapterHref,
  chapterNumber,
  getChapterNeighbors,
  getSortedChapters,
  type Chapter,
} from '../../lib/chapters';

export const getStaticPaths = (async () => {
  const chapters = await getSortedChapters();
  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter },
  }));
}) satisfies GetStaticPaths;

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const { Content, headings } = await render(chapter);
const { prev, next } = await getChapterNeighbors(chapter.id);
const track = tracks.find(t => t.id === chapter.data.track);
---

<BaseLayout title={chapter.data.title} description={chapter.data.summary}>
  <article
    class="chapter-article"
    data-editor-page
    data-editor-kind="static"
    data-editor-track={chapter.data.track}
    data-editor-group={chapter.data.group}
    data-editor-order={chapter.data.order}
    data-editor-slug={chapter.id.split('/').at(-1)}
  >
    <header class="chapter-header">
      <a class="chapter-breadcrumb" href={withBase(`/#${chapter.data.track}`)}>{track?.label} <span>/ {chapter.data.group}</span></a>
      <p class="chapter-kicker">
        CHAPTER {chapterNumber(chapter)}
      </p>
      <h1 data-editor-key="title" class="chapter-title">
        {chapter.data.title}
      </h1>
      <p data-editor-key="subtitle" class="chapter-subtitle">{chapter.data.subtitle}</p>
      {
        chapter.data.summary && (
          <p data-editor-key="summary" class="chapter-summary">
            {chapter.data.summary}
          </p>
        )
      }
    </header>

    <TableOfContents headings={headings} mobile />
    <div class="prose prose-chapter mt-10 max-w-none">
      <Content />
    </div>

    <nav class="chapter-pagination">
      {
        prev ? (
          <a
            href={chapterHref(prev)}
            class="rounded-lg border border-rule p-4 transition-colors hover:border-accent/50 hover:bg-accent-soft/50"
          >
            <span class="font-sans text-sm text-muted">上一章</span>
            <span class="mt-1 block font-serif text-lg font-medium">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={chapterHref(next)}
            class="rounded-lg border border-rule p-4 text-right transition-colors hover:border-accent/50 hover:bg-accent-soft/50 sm:col-start-2"
          >
            <span class="font-sans text-sm text-muted">下一章</span>
            <span class="mt-1 block font-serif text-lg font-medium">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>

  <TableOfContents slot="rail" headings={headings} />
</BaseLayout>
