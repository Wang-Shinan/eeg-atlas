---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { chapterHref, chapterNumber, getTrackSections } from '../lib/chapters';

const sections = await getTrackSections();
---

<BaseLayout>
  <section class="border-b border-rule pb-12">
    <h1 class="font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{site.title}</h1>
    <p class="mt-3 font-sans text-base text-muted">{site.tagline}</p>
    <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed">{site.description}</p>
    <p class="mt-4 font-sans text-sm text-muted lg:hidden">点左上角「目录」可打开章节边栏。</p>
  </section>

  {
    sections.map((section) => (
      <section class="py-12">
        <header class="mb-6">
          <h2 class="font-sans text-[0.6875rem] font-semibold tracking-[0.14em] text-accent">
            {section.track.label}
          </h2>
          <p class="mt-1 font-serif text-sm italic text-muted">{section.track.tagline}</p>
        </header>

        {section.groups.map((group) => (
          <div class="mb-8">
            <h3 class="mb-2 font-sans text-xs font-medium tracking-[0.08em] text-muted">
              {group.name}
            </h3>
            <ul class="border-t border-rule">
              {group.chapters.map((chapter) => (
                <li class="border-b border-rule">
                  <a
                    href={chapterHref(chapter)}
                    class="group flex items-baseline gap-4 py-3.5 transition-colors hover:bg-accent-soft/40"
                  >
                    <span class="w-6 shrink-0 font-sans text-xs tabular-nums text-muted">
                      {chapterNumber(chapter)}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block font-serif text-lg font-medium leading-snug group-hover:text-accent sm:text-xl">
                        {chapter.data.title}
                      </span>
                      <span class="mt-0.5 block font-sans text-sm text-muted">
                        {chapter.data.subtitle}
                      </span>
                    </span>
                    <span
                      aria-hidden="true"
                      class="hidden font-sans text-muted opacity-0 transition-opacity group-hover:opacity-100 sm:inline"
                    >
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }
</BaseLayout>
