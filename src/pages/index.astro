---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import { figures } from '../data/figures';
import { chapterHref, chapterNumber, getTrackSections } from '../lib/chapters';
const sections = await getTrackSections();
const featured = figures.find(f => f.id === 'posterior-alpha')!;
const eegCount = sections.find(s => s.track.id === 'eeg')?.groups.reduce((n, g) => n + g.chapters.length, 0);
const descriptions: Record<string, string> = { '基础': '认识信号、电极与导联，建立读图的坐标。', '正常 EEG': '先熟悉正常背景，再理解变化与差异。', '发育期 EEG': '把年龄与状态放进每一次观察。', '异常 EEG': '从背景异常，到放电与发作的演变。', '参考': '随时查阅中英文术语。' };
---
<BaseLayout>
  <div class="home-masthead"><span class="eyebrow">THE EEG ATLAS</span><span class="edition-label">{eegCount} 章 EEG 教程 · 中文图谱</span></div>
  <section class="home-intro"><div><h1>从认识波形，<br />到读懂脑电图<span class="title-period">。</span></h1><p>循序学习基础、正常与异常脑电。结合图谱观察，在每章自测中巩固理解。</p></div><figure class="home-featured-figure"><div class="figure-heading"><span>READING THE EEG</span><a href={withBase('/chapters/eeg/normal-awake/')}>正常清醒脑电图 ↗</a></div><a href={withBase(featured.src)} data-figure-open data-figure-title={featured.title} aria-label="放大查看后部 α 节律原图" target="_blank" rel="noopener"><img src={withBase(featured.src)} alt={featured.alt} width={featured.width} height={featured.height} decoding="async" fetchpriority="high" /></a><figcaption><strong>先看分布，再看节律。</strong><span>Andrii Cherninskyi · <a href={featured.sourceUrl} target="_blank" rel="noreferrer">原图 / CC BY-SA 4.0</a></span></figcaption></figure></section>
  {sections.map(section => <section id={section.track.id} class:list={['course-section', section.track.id !== 'eeg' && 'secondary-course']}>
    <header class="section-heading"><div><span class="eyebrow">{section.track.id === 'eeg' ? '01 / LEARNING PATH' : section.track.id === 'foundation-models' ? '02 / FOUNDATION MODELS' : '03 / DATASET RULES'}</span><h2>{section.track.label}</h2></div><p>{section.track.tagline}</p></header>
    <div class="course-groups">{section.groups.map((group, index) => <section class="course-group"><header><span class="group-index">{String(index + 1).padStart(2, '0')}</span><div><h3>{group.name}</h3>{descriptions[group.name] && <p>{descriptions[group.name]}</p>}</div></header><ul>{group.chapters.map(chapter => <li><a href={chapterHref(chapter)}><span class="chapter-no">{chapterNumber(chapter)}</span><span class="chapter-label"><strong>{chapter.data.title}</strong><span>{chapter.data.subtitle}</span></span><span class="chapter-arrow" aria-hidden="true">↗</span></a></li>)}</ul></section>)}</div>
  </section>)}
</BaseLayout>
