---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { chapterHref, chapterNumber, getTrackSections } from '../lib/chapters';

const sections = await getTrackSections();
---

<BaseLayout>
  <div class="mx-auto max-w-3xl px-6">
    <section class="border-b border-rule py-20">
      <h1 class="font-serif text-5xl font-semibold tracking-tight sm:text-6xl">{site.title}</h1>
      <p class="mt-3 font-sans text-base text-muted">{site.tagline}</p>
      <p class="mt-8 max-w-xl font-serif text-lg leading-relaxed">{site.description}</p>
    </section>

    {
      sections.map((section) => (
        <section class="py-14">
          <header class="mb-8">
            <h2 class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-accent">
              {section.track.label}
            </h2>
            <p class="mt-1 font-serif text-sm italic text-muted">{section.track.tagline}</p>
          </header>

          {section.groups.map((group) => (
            <div class="mb-10">
              <h3 class="mb-2 font-sans text-xs font-medium uppercase tracking-[0.1em] text-muted">
                {group.name}
              </h3>
              <ul class="border-t border-rule">
                {group.chapters.map((chapter) => (
                  <li class="border-b border-rule">
                    <a
                      href={chapterHref(chapter)}
                      class="group flex items-baseline gap-5 py-4 transition-colors hover:bg-accent-soft/50"
                    >
                      <span class="font-sans text-xs tabular-nums text-muted">
                        {chapterNumber(chapter)}
                      </span>
                      <span class="flex-1">
                        <span class="block font-serif text-xl font-medium leading-snug group-hover:text-accent">
                          {chapter.data.title}
                        </span>
                        <span class="mt-0.5 block font-sans text-sm text-muted">
                          {chapter.data.subtitle}
                        </span>
                      </span>
                      <span
                        aria-hidden="true"
                        class="font-sans text-muted opacity-0 transition-opacity group-hover:opacity-100"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</BaseLayout>
