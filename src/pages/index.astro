---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import { figures } from '../data/figures';
import { chapterHref, chapterNumber, getTrackSections } from '../lib/chapters';
const sections = await getTrackSections();
const featured = figures.find(f => f.id === 'posterior-alpha')!;
const count = sections.find(s => s.track.id === 'eeg')?.groups.filter(g => g.name !== '参考').reduce((n, g) => n + g.chapters.length, 0);
const descriptions: Record<string, string> = { '基础': '信号怎样产生，在哪里记录，怎样观察。', '实验与事件': '从事件标记和试次对照，进入 ERP 成分。', '感知与选择': '外部刺激怎样成为可区分的目标。', '行动与想象': '区分准备、执行、尝试与想象。', '认知与状态': '听觉、语言、工作记忆、反馈、情绪与睡眠。', '应用与边界': '自我调节、临床边界与在线协作。', '参考': '随时查阅；不计入主线章节。' };
---
<BaseLayout>
  <div class="home-masthead"><span class="eyebrow">THE EEG ATLAS</span><span class="edition-label">{count} 章 BCI 主线 · 交互教材第一版</span></div>
  <section class="home-intro"><div><h1>从理解脑电，<br />到设计脑机接口<span class="title-period">。</span></h1><p>沿着信号、实验与任务，理解感知、注意、行动和内部状态。分清组平均差异、单试次解码与在线协作。</p></div><figure class="home-featured-figure"><div class="figure-heading"><span>SIGNAL → EXPERIMENT → INTERFACE</span><a href={withBase('/chapters/eeg/terminology-and-waveforms/')}>从一段真实记录开始 ↗</a></div><a href={withBase(featured.src)} data-figure-open data-figure-title={featured.title} aria-label="放大查看后部 alpha 原图" target="_blank" rel="noopener"><img src={withBase(featured.src)} alt={featured.alt} width={featured.width} height={featured.height} decoding="async" fetchpriority="high" /></a><figcaption><strong>先理解测量，再谈解码。</strong><span>Andrii Cherninskyi · <a href={featured.sourceUrl} target="_blank" rel="noreferrer">原图 / CC BY-SA 4.0</a></span></figcaption></figure></section>
  <p class="edition-note">前三章保留真实样本观察与三维图谱。第四、五章新增明确标注的合成教学演示；其余任务已有首版正文、对照设计和原始研究入口，尚未逐章内嵌真实实验数据。临床异常收拢到一章，旧网址保留为参考。</p>
  {sections.map(section => <section id={section.track.id} class:list={['course-section', section.track.id !== 'eeg' && 'secondary-course']}>
    <header class="section-heading"><div><span class="eyebrow">{section.track.id === 'eeg' ? '01 / EEG & BCI' : section.track.id === 'foundation-models' ? '02 / FOUNDATION MODELS' : '03 / DATASET RULES'}</span><h2>{section.track.label}</h2></div><p>{section.track.tagline}</p></header>
    <div class="course-groups">{section.groups.map((group, index) => <section class="course-group"><header><span class="group-index">{String(index + 1).padStart(2, '0')}</span><div><h3>{group.name}</h3>{descriptions[group.name] && <p>{descriptions[group.name]}</p>}</div></header><ul>{group.chapters.map(chapter => <li><a href={chapterHref(chapter)}><span class="chapter-no">{chapterNumber(chapter)}</span><span class="chapter-label"><strong>{chapter.data.title}</strong><span>{chapter.data.subtitle}</span></span><span class="chapter-arrow" aria-hidden="true">↗</span></a></li>)}</ul></section>)}</div>
  </section>)}
</BaseLayout>
<style>.edition-note{max-width:80ch;padding:1rem 0;border-top:1px solid var(--color-rule);font-size:.92rem;color:var(--color-muted);line-height:1.9}</style>
